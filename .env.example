# ==============================================================================
# Kaveh185 Enterprise Backend — Sample Environment Configuration (.env.example)
# ==============================================================================
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-64-char-random-secret
PII_ENCRYPTION_KEY=replace-with-32-byte-aes-key
PII_BLIND_INDEX_KEY=replace-with-32-byte-hmac-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,kaveh185.ir,api.kaveh185.ir
DJANGO_ADMIN_URL=secure-kaveh185-admin/

# Database (PostgreSQL / MySQL / SQLite)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Cache & Celery (Optional Redis; falls back cleanly to LocMem/Database on cPanel)
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# SMS Gateway (`console` | `iranpayamak` | `kavenegar`)
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_LINE=3000185
OTP_EXPOSE_DEBUG_CODE=True

# Security & Observability
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://kaveh185.ir,https://www.kaveh185.ir
API_DOCS_PUBLIC=True
METRICS_PUBLIC_ENABLED=False
